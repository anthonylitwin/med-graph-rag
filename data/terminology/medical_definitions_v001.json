{
  "schema_version": "medical_definitions_v1",
  "source": "Curated local standard medical definitions for reproducible MedGraphRAG QA",
  "definitions": [
    {
      "type": "Condition",
      "canonical_name": "Hypertriglyceridemia",
      "aliases": ["high triglycerides", "elevated triglycerides", "high TG"],
      "definition": "Hypertriglyceridemia is a condition in which triglyceride levels in the blood are elevated.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#hypertriglyceridemia"
    },
    {
      "type": "Condition",
      "canonical_name": "Atherosclerosis",
      "aliases": ["atherosclerotic cardiovascular disease"],
      "definition": "Atherosclerosis is a disease process in which plaque builds up in artery walls and can restrict blood flow.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#atherosclerosis"
    },
    {
      "type": "Biomarker",
      "canonical_name": "Triglycerides",
      "aliases": ["TG", "TGs", "triglyceride"],
      "definition": "Triglycerides are a type of fat measured in blood tests and used as a lipid biomarker.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#triglycerides"
    },
    {
      "type": "Biomarker",
      "canonical_name": "HDL cholesterol",
      "aliases": ["HDL-C", "HDL", "high-density lipoprotein cholesterol"],
      "definition": "HDL cholesterol is cholesterol carried by high-density lipoprotein particles and is commonly measured in lipid panels.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#hdl_cholesterol"
    },
    {
      "type": "Biomarker",
      "canonical_name": "LDL cholesterol",
      "aliases": ["LDL-C", "LDL", "low-density lipoprotein cholesterol"],
      "definition": "LDL cholesterol is cholesterol carried by low-density lipoprotein particles and is commonly used as a marker of atherogenic lipid burden.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#ldl_cholesterol"
    },
    {
      "type": "Biomarker",
      "canonical_name": "Atherogenic lipoproteins",
      "aliases": ["atherogenic remnant particles", "atherogenic lipoprotein particles"],
      "definition": "Atherogenic lipoproteins are lipid particles that can contribute to plaque formation in arteries.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#atherogenic_lipoproteins"
    },
    {
      "type": "Condition",
      "canonical_name": "Type 2 diabetes mellitus",
      "aliases": ["T2DM", "type II diabetes", "type 2 diabetes"],
      "definition": "Type 2 diabetes mellitus is a chronic metabolic condition characterized by insulin resistance and elevated blood glucose.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#type_2_diabetes_mellitus"
    },
    {
      "type": "Condition",
      "canonical_name": "Cardiovascular disease",
      "aliases": ["CVD", "cardiovascular diseases"],
      "definition": "Cardiovascular disease is a broad category of disorders affecting the heart or blood vessels.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#cardiovascular_disease"
    },
    {
      "type": "Condition",
      "canonical_name": "Chronic kidney disease",
      "aliases": ["CKD", "chronic renal disease"],
      "definition": "Chronic kidney disease is a long-term condition in which kidney structure or function is impaired.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#chronic_kidney_disease"
    },
    {
      "type": "Condition",
      "canonical_name": "Metabolic syndrome",
      "aliases": ["insulin resistance syndrome"],
      "definition": "Metabolic syndrome is a cluster of cardiometabolic risk factors that commonly includes abdominal obesity, dyslipidemia, elevated blood pressure, and abnormal glucose regulation.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#metabolic_syndrome"
    },
    {
      "type": "Condition",
      "canonical_name": "Combined dyslipidemia",
      "aliases": ["mixed dyslipidemia", "atherogenic dyslipidemia"],
      "definition": "Combined dyslipidemia is a lipid disorder involving abnormalities across multiple lipid measures, commonly including high triglycerides and low HDL cholesterol.",
      "source_label": "MedGraphRAG curated definition v001",
      "source_url": "local://medical_definitions_v001#combined_dyslipidemia"
    }
  ]
}
