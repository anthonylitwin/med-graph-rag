# API
API_PORT=8000

# WEB
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_CHAT_TIMEOUT_MS=120000

# Neo4j
# Inside docker network
NEO4J_URI=bolt://neo4j:7687
# From host machine
NEO4J_LOCAL_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=medgraphrag-password

# OpenAI extraction and experiment-only frontier runs
OPENAI_API_KEY=put-openai-api-key-here
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium

# App launch model runtime
# The launched API/web app is local-only. Supported app profiles: local-non-instruct, local-gliner, noop.
APP_MODEL_PROFILE=local-non-instruct
LOCAL_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
APP_QA_MODEL_TIMEOUT_SECONDS=90
EXTRACTOR_ENTITY_MODEL=Ihor/gliner-biomed-small-v1.0
GLINER_ENTITY_THRESHOLD=0.35

# Experiment and CLI model runtime profiles
# Supported: frontier, local-qwen25, local-qwen3, local-gliner, local-non-instruct, noop
MODEL_PROFILE=frontier

# Optional experiment overrides; usually leave these unset and use MODEL_PROFILE.
# QA_PROVIDER=openai
# QA_MODEL=gpt-5.5
# QA_RETRIEVER=graph
# EXTRACTOR_PROVIDER=openai
# EXTRACTOR_MODEL=gpt-5.5

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Example environment variables
APP_ENV=development
API_HOST=0.0.0.0
UI_PORT=8501
